# Force LF on checkout everywhere; git auto-detects text vs binary.
* text=auto eol=lf

# Windows shell scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated outputs: hide from diffs and language stats.
/diagram.html -diff linguist-generated=true
/examples/demo/layout.html -diff linguist-generated=true
/examples/demo/index.html -diff linguist-generated=true
/examples/demo/demo.excalidraw -diff linguist-generated=true
